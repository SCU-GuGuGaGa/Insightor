# =============================================================================
# Insightor 环境变量配置文件
#
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 填入您的 API 密钥（见下方说明）
#   3. .env 文件应放在您要审查的项目根目录（不要提交到 Git！）
#
# 详细配置指南：https://github.com/SCU-GuGuGaGa/Insightor/blob/main/INSTALLATION.md
# =============================================================================

# ============================================================================
# 1. GitHub Token（必需）
# ============================================================================
# 用途：访问 GitHub PR 数据（读取代码变更、评论等）
#
# 获取方式：
#   1. 访问 https://github.com/settings/tokens
#   2. 点击 "Generate new token" → "Generate new token (classic)"
#   3. 勾选权限：
#      ✅ repo（完整仓库权限）
#      ✅ read:org（如果需要访问组织私有仓库）
#   4. 生成后复制 token（格式：ghp_xxxxx）
#
# ⚠️ 注意：Token 只显示一次，请妥善保存！
# ============================================================================
GITHUB_TOKEN=

# ============================================================================
# 2. LLM API Key（至少选择一个）
# ============================================================================
# Insightor 支持多个 LLM 提供商，您可以：
#   - 只配置一个（推荐新手）
#   - 配置多个作为备选
#   - 不同深度使用不同模型（见下方"模型配置"）
#
# 如何选择？
#   - OpenAI：稳定、文档全，需要海外信用卡
#   - DeepSeek：便宜（OpenAI 的 1/10）、中文友好、国内快 ✅ 推荐国内用户
#   - Claude：推理能力最强、代码理解好，价格较高
# ============================================================================

# ---- 选项 1: OpenAI ----
# 获取地址：https://platform.openai.com/api-keys
# 格式：sk-proj-xxxxx
OPENAI_API_KEY=

# ---- 选项 2: Anthropic Claude ----
# 获取地址：https://console.anthropic.com/settings/keys
# 格式：sk-ant-xxxxx
ANTHROPIC_API_KEY=

# ---- 选项 3: DeepSeek（推荐国内用户）----
# 获取地址：https://platform.deepseek.com/api_keys
# 格式：sk-xxxxx
DEEPSEEK_API_KEY=

# ============================================================================
# 3. 第三方 API 网关配置（可选 - 仅在使用第三方服务时需要）
# ============================================================================
# ⚠️ 注意：如果使用官方 API，可以完全跳过本节配置！
#
# 什么时候需要配置 Base URL？
#   ✅ 使用第三方 API 网关（如 cc-vibe、api.laozhang.ai、openrouter.ai）
#   ❌ 使用官方 API（OpenAI、Anthropic、DeepSeek）- 留空即可
#
# 官方默认地址：
#   - OpenAI: https://api.openai.com
#   - Anthropic: https://api.anthropic.com
#   - DeepSeek: https://api.deepseek.com
#
# ⚠️ 第三方服务常见问题：
#   问题：部分供应商的 "CC"（Claude Code）类型 key 仅允许官方 CLI 使用，
#        SDK/curl 请求会被 403 拒绝
#   解决：在供应商后台生成 "API" 类型的 key（非 CC 类型）
#   已验证可用：cc-vibe、api.laozhang.ai、openrouter.ai
# ============================================================================

# OpenAI 兼容端点（留空使用官方 API）
# OPENAI_API_BASE=

# Anthropic Claude 端点（留空使用官方 API）
# ANTHROPIC_BASE_URL=

# DeepSeek 端点（留空使用官方 API）
# DEEPSEEK_API_BASE=

# ============================================================================
# 4. 模型配置（可选）
# ============================================================================
# Insightor 按分析深度自动选择模型，您可以自定义每个深度使用的模型：
#
# 分析深度          CLI 参数          默认模型              说明
# ───────────────  ───────────────  ──────────────────  ─────────────────
# quick（快速）     --depth quick    deepseek-v4-flash   轻量模型，省钱
# standard（标准）  --depth standard deepseek-v4-pro     默认模式
# deep（深度）      --depth deep     deepseek-v4-pro     深度分析
#
# ⚠️ 重要：如果只配置了一个提供商的 API Key（如只有 OPENAI_API_KEY），
#         必须覆盖所有三个模型配置，否则会因缺少 DeepSeek key 而失败！
# ============================================================================

# ---- 示例 1: 全部使用 OpenAI ----
# INSIGHTOR_MODELS_PRIMARY=gpt-4o           # 标准模式
# INSIGHTOR_MODELS_WEAK=gpt-4o-mini         # 快速模式（省钱）
# INSIGHTOR_MODELS_REASONING=gpt-4o         # 深度模式

# ---- 示例 2: 全部使用 Claude ----
# INSIGHTOR_MODELS_PRIMARY=claude-sonnet-4-6
# INSIGHTOR_MODELS_WEAK=claude-sonnet-4-6
# INSIGHTOR_MODELS_REASONING=claude-opus-4-8

# ---- 示例 3: 全部使用 DeepSeek（默认，无需配置）----
# INSIGHTOR_MODELS_PRIMARY=deepseek-v4-pro
# INSIGHTOR_MODELS_WEAK=deepseek-v4-flash
# INSIGHTOR_MODELS_REASONING=deepseek-v4-pro

# ---- 示例 4: 混合使用（需要配置多个 API Key）----
# INSIGHTOR_MODELS_WEAK=deepseek-v4-flash        # 快速模式用便宜的
# INSIGHTOR_MODELS_PRIMARY=claude-sonnet-4-6     # 标准模式用好的
# INSIGHTOR_MODELS_REASONING=claude-opus-4-8     # 深度模式用最强的

# ============================================================================
# 5. 其他高级配置（可选）
# ============================================================================
# 最低严重程度（忽略更低级别的发现）
# INSIGHTOR_REVIEW_MIN_SEVERITY=medium

# 最多返回的发现数量
# INSIGHTOR_REVIEW_MAX_FINDINGS=20

# 最大输入 Token 数
# INSIGHTOR_TOKEN_MAX_INPUT_TOKENS=32000


# ============================================================================
# 📝 完整配置示例
# ============================================================================

# ---- 示例 1: 新手快速开始（使用 DeepSeek 官方 API，推荐）----
# GITHUB_TOKEN=ghp_你的GitHub_token
# DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
# # Base URL 留空，自动使用官方 API
# INSIGHTOR_MODELS_PRIMARY=deepseek-v4-pro
# INSIGHTOR_MODELS_WEAK=deepseek-v4-flash
# INSIGHTOR_MODELS_REASONING=deepseek-v4-pro

# ---- 示例 2: 使用官方 OpenAI API ----
# GITHUB_TOKEN=ghp_你的GitHub_token
# OPENAI_API_KEY=sk-proj-你的OpenAI密钥
# # Base URL 留空，自动使用官方 API
# INSIGHTOR_MODELS_PRIMARY=gpt-4o
# INSIGHTOR_MODELS_WEAK=gpt-4o-mini
# INSIGHTOR_MODELS_REASONING=gpt-4o

# ---- 示例 3: 使用官方 Anthropic Claude API ----
# GITHUB_TOKEN=ghp_你的GitHub_token
# ANTHROPIC_API_KEY=sk-ant-你的Claude密钥
# # Base URL 留空，自动使用官方 API
# INSIGHTOR_MODELS_PRIMARY=claude-sonnet-4-6
# INSIGHTOR_MODELS_WEAK=claude-sonnet-4-6
# INSIGHTOR_MODELS_REASONING=claude-opus-4-8

# ---- 示例 4: 使用第三方 Claude 网关（需要配置 Base URL）----
# GITHUB_TOKEN=ghp_你的GitHub_token
# ANTHROPIC_API_KEY=sk-你的第三方密钥
# ANTHROPIC_BASE_URL=https://api.your-gateway.com  # ← 第三方服务才需要
# INSIGHTOR_MODELS_PRIMARY=claude-sonnet-4-6
# INSIGHTOR_MODELS_WEAK=claude-sonnet-4-6
# INSIGHTOR_MODELS_REASONING=claude-sonnet-4-6

# ============================================================================
# 💡 快速测试
# ============================================================================
# 配置完成后，测试是否正常工作：
#
#   1. 激活虚拟环境（如果使用）
#   2. 运行：python -m insightor review <PR_URL> --depth quick
#   3. 查看是否成功生成审查报告
#
# 遇到问题？查看详细指南：
#   https://github.com/SCU-GuGuGaGa/Insightor/blob/main/INSTALLATION.md
# ============================================================================
