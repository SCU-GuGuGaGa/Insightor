{
  "name": "insightor-vscode",
  "displayName": "Insightor - AI PR Review",
  "description": "AI-powered GitHub PR review in VSCode. Native TypeScript implementation - no Python required! Supports OpenAI, Anthropic, DeepSeek.",
  "version": "0.2.1",
  "publisher": "codingNow",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SCU-GuGuGaGa/Insightor.git"
  },
  "bugs": {
    "url": "https://github.com/SCU-GuGuGaGa/Insightor/issues"
  },
  "homepage": "https://github.com/SCU-GuGuGaGa/Insightor#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "github",
    "pull request",
    "code review",
    "ai",
    "llm",
    "typescript",
    "native",
    "openai",
    "anthropic",
    "deepseek"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "insightor.reviewPR",
        "title": "Insightor: Review PR",
        "icon": "$(search-view-icon)"
      },
      {
        "command": "insightor.describePR",
        "title": "Insightor: Describe PR",
        "icon": "$(file-text)"
      },
      {
        "command": "insightor.risksPR",
        "title": "Insightor: Analyze Risks",
        "icon": "$(warning)"
      },
      {
        "command": "insightor.fullReview",
        "title": "Insightor: Full Review",
        "icon": "$(checklist)"
      },
      {
        "command": "insightor.publishReview",
        "title": "Insightor: Publish Review",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "insightor.openSettings",
        "title": "Insightor: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "insightor.refreshView",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "insightor.viewFinding",
        "title": "View Finding Details"
      },
      {
        "command": "insightor.applyFix",
        "title": "Apply Fix",
        "icon": "$(check)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "insightor-sidebar",
          "title": "Insightor",
          "icon": "resources/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "insightor-sidebar": [
        {
          "id": "insightorWelcome",
          "name": "Quick Actions",
          "type": "webview"
        },
        {
          "id": "insightorView",
          "name": "Review Results",
          "icon": "resources/sidebar-icon.svg",
          "contextualTitle": "Insightor"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "insightor.fullReview",
          "when": "view == insightorView",
          "group": "navigation@1"
        },
        {
          "command": "insightor.refreshView",
          "when": "view == insightorView",
          "group": "navigation@2"
        },
        {
          "command": "insightor.openSettings",
          "when": "view == insightorView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "insightor.viewFinding",
          "when": "view == insightorView && viewItem == finding"
        },
        {
          "command": "insightor.applyFix",
          "when": "view == insightorView && viewItem == finding",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "insightor.fullReview",
          "group": "insightor@1",
          "when": "editorTextFocus"
        },
        {
          "command": "insightor.reviewPR",
          "group": "insightor@2",
          "when": "editorTextFocus"
        },
        {
          "command": "insightor.describePR",
          "group": "insightor@3",
          "when": "editorTextFocus"
        },
        {
          "command": "insightor.risksPR",
          "group": "insightor@4",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "insightor.publishReview",
          "group": "insightor@1",
          "when": "resourceExtname == .md && resourceFilename =~ /insightor-.*\\.md/"
        }
      ],
      "commandPalette": [
        {
          "command": "insightor.reviewPR",
          "when": "true"
        },
        {
          "command": "insightor.describePR",
          "when": "true"
        },
        {
          "command": "insightor.risksPR",
          "when": "true"
        },
        {
          "command": "insightor.fullReview",
          "when": "true"
        },
        {
          "command": "insightor.publishReview",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Insightor",
      "properties": {
        "insightor.useNativeImplementation": {
          "type": "boolean",
          "default": true,
          "description": "Use native TypeScript implementation (no Python required). Set to false to use Python CLI."
        },
        "insightor.githubToken": {
          "type": "string",
          "default": "",
          "description": "GitHub Personal Access Token (required for native implementation)"
        },
        "insightor.llm.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "deepseek"
          ],
          "default": "deepseek",
          "description": "LLM provider to use"
        },
        "insightor.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "LLM API Key (required for native implementation)"
        },
        "insightor.llm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional: Custom API base URL for third-party providers"
        },
        "insightor.llm.model": {
          "type": "string",
          "default": "",
          "description": "Optional: Override default model (e.g., gpt-4o, claude-sonnet-4)"
        },
        "insightor.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "[Python CLI mode only] Path to Python executable"
        },
        "insightor.defaultDepth": {
          "type": "string",
          "enum": [
            "quick",
            "standard",
            "deep"
          ],
          "default": "standard",
          "description": "Default analysis depth"
        },
        "insightor.autoOpenResults": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open results in editor after analysis"
        },
        "insightor.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification messages"
        },
        "insightor.model": {
          "type": "string",
          "default": "",
          "description": "[Deprecated] Use insightor.llm.model instead"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^2.3.x",
    "@vscode/vsce": "^2.22.x",
    "eslint": "^8.x",
    "typescript": "^5.3.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@octokit/rest": "^22.0.1",
    "axios": "^1.18.1",
    "openai": "^6.49.0"
  }
}
